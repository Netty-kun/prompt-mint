#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Skip pre-commit hooks during CI
if [ -n "$CI" ]; then
  exit 0
fi

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

# Rust formatting and linting (contracts)
RUST_FILES=$(echo "$STAGED_FILES" | grep -E '\.(rs)$' | grep 'contracts/' | head -c 1)
if [ -n "$RUST_FILES" ]; then
  echo "Running rustfmt on contract code..."
  cargo fmt --all --check || {
    echo "Error: rustfmt check failed. Run 'cargo fmt --all' to fix formatting."
    exit 1
  }

  echo "Running clippy on contract code..."
  cargo clippy --workspace --all-targets --locked -- -D warnings || {
    echo "Error: clippy checks failed. Address warnings and try again."
    exit 1
  }
fi

# TypeScript and JavaScript checks
TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' | grep -v 'node_modules' | head -c 1)
if [ -n "$TS_FILES" ]; then
  echo "Running TypeScript typecheck..."
  yarn typecheck || {
    echo "Error: TypeScript typecheck failed."
    exit 1
  }

  echo "Running ESLint..."
  yarn lint || {
    echo "Error: ESLint found issues."
    exit 1
  }
fi

echo "✓ Pre-commit checks passed"
